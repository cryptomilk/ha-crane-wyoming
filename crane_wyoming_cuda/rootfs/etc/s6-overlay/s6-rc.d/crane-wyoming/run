#!/command/with-contenv bashio
# shellcheck shell=bash

flags=()

model_path="$(bashio::config 'model_path')"

if bashio::config.true 'cpu_only'; then
    flags+=('--cpu')
fi

if bashio::config.true 'tts_cache_enabled'; then
    flags+=('--tts-cache-dir' '/data/tts-cache')
    flags+=('--tts-cache-max-size' "$(bashio::config 'tts_cache_max_size')")
fi

if bashio::config.true 'debug_logging'; then
    export RUST_LOG=debug
fi

exec /usr/local/bin/crane-wyoming \
    --model-path "${model_path}" \
    --host 0.0.0.0 \
    --port 10200 \
    --max-connections "$(bashio::config 'max_connections')" \
    "${flags[@]}"
