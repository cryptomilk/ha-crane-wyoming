#!/command/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Take down the S6 supervision tree when crane-wyoming fails
# s6-overlay docs: https://github.com/just-containers/s6-overlay
# ==============================================================================
if [[ "${1}" -ne 0 ]] && [[ "${1}" -ne 256 ]]; then
    bashio::log.warning "crane-wyoming exited with code ${1}"
fi

if [[ "${1}" -eq 256 ]]; then
    exit "${2}"
fi

if [[ "${1}" -eq 0 ]]; then
    exit 0
fi

exit "${1}"
